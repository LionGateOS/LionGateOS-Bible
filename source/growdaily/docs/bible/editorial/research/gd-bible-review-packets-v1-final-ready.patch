+def write_json(path, obj):
+    with open(path, "w", encoding="utf-8", newline="\n") as handle:
+        handle.write(json.dumps(obj, ensure_ascii=False))
+    return path
+
+
+def write_jsonl(path, rows):
+    with open(path, "w", encoding="utf-8", newline="\n") as handle:
+        for row in rows:
+            handle.write(PACKETS.dumps(row) + "\n")
+    return path
+
