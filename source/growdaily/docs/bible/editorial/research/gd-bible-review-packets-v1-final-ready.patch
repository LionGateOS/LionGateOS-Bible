+        },
+    ],
+}
+
+FIXTURE_SPECS = (
+    [("b1:c1:v1", "terminology")]
+    + [("b1:c1:v5", "wording"), ("b1:c1:v5", "capitalization")]
+    + [("b1:c1:v3", "translation")] * 20
